				{
					"name": "Submit async bulk job",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{v2Url}}/api/v2/urls/bulk",
							"host": [
								"{{v2Url}}"
							],
							"path": [
								"api",
								"v2",
								"urls",
								"bulk"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"urls\": [\n    {\n      \"longUrl\": \"https://example.com/bulk-item-1\"\n    },\n    {\n      \"longUrl\": \"https://example.com/bulk-item-2\"\n    },\n    {\n      \"longUrl\": \"https://example.com/bulk-item-3\"\n    }\n  ]\n}",
							"options": {
