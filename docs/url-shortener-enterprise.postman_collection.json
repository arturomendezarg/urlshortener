    {
      "name": "2. Brownfield - V1 baseline, then V2 cutover",
      "description": "Tests V1 first as the pre-existing baseline system, then represents 'a commit that activates V2' by creating the same link on V2, and verifies how the Gateway resolves the new V2 code before and after it has been read directly against V2 at least once. Maps to the Day 2 scenario documented in ARCHITECTURE.md (V1-only baseline, then V2 cutover) and reproduces the open cache-as-index defect live, without hard-failing the run. Run '0. Auth' first.",
      "item": [
        {
          "name": "Create short link (V1 - the pre-existing system)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{v1Url}}/api/v1/urls",
              "host": [
                "{{v1Url}}"
              ],
              "path": [
                "api",
                "v1",
                "urls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"longUrl\": \"https://www.anthropic.com/news\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "V1 requires no token - it is the pre-existing 'legacy' system, running before any V2 cutover. This is the Day 1 / brownfield baseline."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
