						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{v2Url}}/api/v2/urls",
							"host": [
								"{{v2Url}}"
							],
							"path": [
								"api",
								"v2",
								"urls"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"longUrl\": \"https://example.com/reserved-test\",\n  \"customAlias\": \"api\"\n}",
							"options": {
								"raw": {
									"language": "json"
