<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v1.0-init-urls-table" author="art-claude-dev">
        <comment>
            Initial URLs table for Monolith V1. Deliberately does NOT include expires_at:
            that column is added in a later changelog (Day 2, Brownfield scenario) with no
            downtime. See ARCHITECTURE.md, section 6.
        </comment>
        <createTable tableName="urls">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="short_code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_urls_short_code"/>
            </column>
            <column name="long_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
