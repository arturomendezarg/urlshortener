<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.artmendez.urlshortener</groupId>
  <artifactId>url-shortener-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>URL Shortener - Parent</name>
  <description>URL shortener prototype - AI-assisted engineering exercise project. See ARCHITECTURE.md.</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
  </properties>

  <!--
    Modules are added one by one as each task in the plan (ARCHITECTURE.md §7) is
    implemented in its own PR, to keep task-by-task traceability.
  -->
  <modules>
    <module>v1-legacy-monolith</module>
    <module>api-gateway</module>
    <module>v2-shortener-contract</module>
    <module>analytics-worker</module>
    <module>v2-shortener-service</module>
    <module>bulk-processor</module>
  </modules>

  <!--
    Cross-cutting quality gates (see ARCHITECTURE.md section 11 and AI_USAGE_LOG.md): declared
    here as <build><plugins> (not <pluginManagement>) so that every child module runs them
    automatically in its verify phase, without having to repeat the configuration.

    - checkstyle: static analysis of style/common errors (own ruleset in checkstyle.xml,
      deliberately scoped so it can start as a real gate without generating a wave of violations
      against already-written code).
    - spotbugs: static analysis of bug patterns on the compiled bytecode.

    Dependency scanning (security) was solved with GitHub Dependabot instead of a Maven
    plugin — see ARCHITECTURE.md section 11 for the rationale behind that change of approach.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.10.4.0</version>
        <configuration>
          <effort>Default</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
          <!--
            Narrow, documented exceptions only — see spotbugs-exclude.xml itself for exactly
            which classes/patterns are excluded and why (Task #9, v2-shortener-service).
          -->
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
